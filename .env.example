# Required by SEC EDGAR — they reject requests without a real contact address.
# Format: "AppName your@email.com"
SEC_USER_AGENT=FINAI educational project your@email.com

# Optional. Without it the app still works, but has no share price,
# so market cap, P/E and DCF upside render as em dashes.
# Free key: https://finnhub.io/register  (60 calls/min)
FINNHUB_API_KEY=
